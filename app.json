{
  "expo": {
    "name": "BlogApp",
    "slug": "BlogApp",
    "version": "1.0.0",
    "orientation": "portrait",
    
    "scheme": "blogapp",
    "userInterfaceStyle": "automatic",

    "ios": {
      "supportsTablet": true,
      "buildNumber": "1017756",
      "bundleIdentifier": "com.tumeloxbandile.blogapp",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },

    "android": {
      "versionCode": 1017756,
      "predictiveBackGestureEnabled": false
    },

    "web": {
      "output": "static"
    },

    "plugins": [
      "expo-router",
      "expo-secure-store"
    ],

    "experiments": {
      "typedRoutes": true
    },

    "extra": {
      "router": {},
      "eas": {
        "projectId": "d534d194-c3de-45ce-9070-22ce4cb7964d"
      }
    }
  }
}